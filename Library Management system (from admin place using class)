class Book:
	def __init__(self,title,author,category,available=True):
		self.title = title
		self.author = author
		self.category = category
		self.available = available
	def mark_as_borrowed(self):
		self.available = False
	def info(self):
		print(f"\n{'Title':<15}:{self.title}")
		print(f"{'Category':<15}:{self.category}")
		print(f"{'Available':<15}:{self.available}")
		print(f"{'Author':<15}:{self.author}\n")
class Member:
	def __init__(self,name):
		self.name = name
		self.borrowed_books = []
	def borrow_book(self,book):
		if not book.available:
			print("\n[-] This book is not Available")
			return
		self.borrowed_books.append(book)
		book.mark_as_borrowed()
		print(f"\n[+] Book: {book.title} is borrowed")
	def return_book(self,book):
		if not book in self.borrowed_books:
			print("\n[-] This book is not borrowed!")
			return
		self.borrowed_books.remove(book)
		book.available = True
		print(f"\n[+] Book: {book.title} is returned")
	def info(self):
		print(f"\n{self.name}\'s Info: \n")
		print(f"{'Name':<15}:{self.name}")
		print(f"Borrowed Books: \n")
		count = 0
		for n in range(len(self.borrowed_books)):
			count += 1
			print(f"{count}. {self.borrowed_books[n].title}")
class Library:
	def __init__(self,name):
		self.name = name
		self.books = []
		self.members = []
	def borrow_book(self,name,book):
		if not book in self.books:
			print(f"\n[-] Book: {book.title} is not in the library")
			return
		if not name in self.members:
			print(f"\n[-] Name: {name.name} is not Member")
		name.borrow_book(book)
	def return_book(self,name,book):
		name.return_book(book)
	def book_info(self,book):
		if not book in self.books:
			print(f"\n[-] Book: {book.title} is not in the library")
			return
		book.info()
	def member_info(self,name):
		if not name in self.members:
			print(f"\n[-] Name: {name.name} is not Member")
			return
		name.info()
	def all_members(self):
		print("\n========[ MEMBERS ]========\n")
		count = 0
		for member in self.members:
			count += 1
			print(f"{count}. {member.name}")
	def all_books(self):
		print("\n========[ BOOKS ]=======\n")
		count = 0
		for book in self.books:
			count += 1
			print(f"{count}. {book.title}")
	def statistics(self):
		total_books = 0
		available_book = 0
		borrowed_book = 0
		members = 0
		for book in self.books:
			total_books += 1
			if book.available:
				available_book += 1
			if not book.available:
				borrowed_book += 1
		for member in self.members:
			members += 1
		print(f"{'Total Books':<20}:{total_books}")
		print(f"{'Available':<20}:{available_book}")
		print(f"{'Borrowed':<20}:{borrowed_book}")
		print(f"{'Members':<20}:{members}")
